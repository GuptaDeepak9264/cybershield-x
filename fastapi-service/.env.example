# Copy to .env. Must point at the SAME MySQL database as django-service/.env.

DB_ENGINE=mysql
DB_NAME=cybershield_x
DB_USER=cybershield_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Only used when DB_ENGINE=sqlite3 (local dev without a MySQL server) -
# point this at django-service's db.sqlite3 so both services see the
# same schema/data.
SQLITE_PATH=../django-service/db.sqlite3

# MUST exactly match JWT_SECRET in django-service/.env - this service
# only verifies tokens Django issues, it never signs its own.
JWT_SECRET=change-me-to-a-different-random-string-than-SECRET_KEY

# Optional. Leave blank to run the AI Security Assistant in rule-based
# fallback mode (no external calls, no cost).
OPENAI_API_KEY=

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
