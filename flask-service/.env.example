# Copy to .env. Must point at the SAME MySQL database as django-service/.env.

DB_ENGINE=mysql
DB_NAME=cybershield_x
DB_USER=cybershield_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Only used when DB_ENGINE=sqlite3 (local dev without MySQL).
SQLITE_PATH=../django-service/db.sqlite3

# MUST exactly match JWT_SECRET in django-service/.env and fastapi-service/.env.
JWT_SECRET=change-me-to-a-different-random-string-than-SECRET_KEY

# Where generated PDFs are written when USE_S3=False. Point this at
# django-service's media/ folder for local dev (see README).
MEDIA_ROOT=../django-service/media

# Object storage (Milestone 6). Set USE_S3=True in production - MUST use
# the same bucket/credentials as django-service's AWS_* vars, since both
# services read/write the same "reports/" prefix in that bucket.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Email - leave SMTP_HOST blank to run in console/file fallback mode
# (writes to EMAIL_OUTBOX_PATH instead of sending, no cost, fully testable).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=no-reply@cybershieldx.local
EMAIL_OUTBOX_PATH=email_outbox.log
