# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Django core ---
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# DB_ENGINE=mysql for real usage. DB_ENGINE=sqlite3 for a quick local
# run/test loop on a machine without a MySQL server installed.
DB_ENGINE=mysql
DB_NAME=cybershield_x
DB_USER=cybershield_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Session / CSRF (leave defaults for local dev) ---
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=

# --- JWT (issued here, verified by FastAPI/Flask) ---
JWT_SECRET=change-me-to-a-different-random-string-than-SECRET_KEY
JWT_EXPIRATION_MINUTES=60

# --- Downstream services (Milestone 5) ---
FASTAPI_BASE_URL=http://127.0.0.1:8001
FLASK_BASE_URL=http://127.0.0.1:8002
INTEGRATION_TIMEOUT_SECONDS=10

# --- Object storage (Milestone 6) ---
# Leave USE_S3=False for local dev (uses local disk media/, as in
# Milestones 1-5). Set USE_S3=True in production - see DEPLOYMENT.md.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_AUTH=True

# --- Production hardening ---
# Both auto-derive from DEBUG if left unset entirely (omitted, not blank -
# python-decouple's bool/int casting chokes on an empty string). Uncomment
# and set explicitly only if you need to override the DEBUG-based default:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=604800

TIME_ZONE=UTC
